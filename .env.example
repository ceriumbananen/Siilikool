# Kopiera till .env och fyll i från Supabase: Project Settings → API.
# Bara den publika nyckeln (anon/publishable) – aldrig service_role/secret.
NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=

# Bara för "yarn buggar" (scripts/buggar.mjs) - läser buggrapporter förbi RLS. Hemlig: använd
# ALDRIG denna i NUXT_PUBLIC_*-variabler eller i appens egen kod. Supabase: Project Settings →
# API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
